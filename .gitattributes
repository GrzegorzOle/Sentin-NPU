# Line endings, decided here rather than by whoever cloned the repository.
#
# The project is developed on both Linux and Windows, and a Windows checkout with
# core.autocrlf=true rewrites text files to CRLF. For most files that is harmless. For a shell
# script it is not: a CRLF `#!/bin/sh` fails with "bad interpreter: /bin/sh^M", and the script
# that breaks is the one that builds the AppImage or installs the Wazuh rules - on a machine
# nobody here will ever see.

* text=auto

# Anything a kernel or an interpreter has to read must keep LF, on every platform.
*.sh          text eol=lf
AppRun        text eol=lf
*.service     text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.py          text eol=lf
*.rs          text eol=lf
*.toml        text eol=lf
*.xml         text eol=lf
*.ndjson      text eol=lf
*.conf        text eol=lf

# Inno Setup reads this on Windows and its own convention is CRLF.
*.iss         text eol=crlf
*.ps1         text eol=crlf

# Binary, never touched.
*.png         binary
*.svg         text eol=lf
*.tar.gz      binary
*.zip         binary
*.bin         binary
