# Private working notes — never committed (also in .git/info/exclude)
CLAUDE.md
PLAN.md

# Rust
gateway/target/
**/*.rs.bk

# Python
tools/.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Build artefacts of the diagnostic bundle (hundreds of MB; rebuilt by scripts/make-bundle.sh)
dist/
gateway/target-bullseye/
gateway/target-win/

# Model artifacts — IR ships as GitHub Release assets, never in the repo
models/*
!models/.gitkeep

# Benchmark and diagnostic output
docs/benchmarks/raw/
# Audit-event output written by the gateway at run time. Scoped deliberately: a blanket
# *.jsonl rule silently swallows tests/fixtures/*.jsonl, which must be committed.
/sentin-audit.jsonl
*-audit.jsonl
# The one place that pattern is wrong. docs/wazuh/examples holds synthetic events an administrator
# pastes into wazuh-logtest before there is any real traffic, and `sample-audit.jsonl` matched the
# rule above - so the file the deployment guides tell people to use would have been missing from
# both the repository and every release bundle, silently. Negated for the whole directory rather
# than for one name: the next sample added there would hit exactly the same trap.
!docs/wazuh/examples/*.jsonl

# The installer ISCC writes beside its own script. A quarter of a gigabyte, rebuilt from the
# bundle whenever it is needed, and one `git add -A` away from the public repository - which is
# how it was noticed.
packaging/windows/out/
